
public class Main {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		System.out.println("Hello world");
		
		int a;
		a = 1;
		
		long b = 1;
		short aa = 0;
		System.out.println("int a = " + a);
		System.out.println("long b = " + b);
		
		
		float c = 0.1f;
		double d = 1.0;
		
		System.out.println("float c = " + c);
		System.out.println("double d = " + d);
		
		//8진수 > 0 ~ 7
		int e = 05; //8진수 5
		e = 075; //75 << 10진수, 8진수 61
		
		//16진수 0 ~ 9, a, b, c, d, e, f
		int f = 0xAC; // 172
		
		System.out.println("int(octal) e =" + e);
		System.out.println("int(hex) f = " + f);
		
		//사칙연산 연산자 + - * / % ++ --
		// a = int b = long
		System.out.println("a + b = " + (a + b));
		System.out.println("a + d = " + (a + b));
		System.out.println("a + f = " + (a + f));
		System.out.println("a - b = " + (a - b));
		System.out.println("a - d = " + (a - b));
		System.out.println("a - f = " + (a - f));
		
		a = 7;
		b = 4;
		
		System.out.println("a % b = " + (a % b)); //3
		System.out.println("b % a = " + (b % a)); //4
		
		// --, ++ 숫자 앞에 붙냐, 뒤에 붙냐 달라져요.
		System.out.println("a++ = " + a++); //7
		System.out.println("a = " + a); //8
		
		boolean g;
		g = a > b; //8 > 4 true
		System.out.println("g = " + g);
		
		char h;
		h = 'a';
		System.out.println(h);
		h = 97; //a
		System.out.println(h);
		h = '\u0000';
		System.out.println(h);
		
		String i = "abc";
		String j = "abc";
		
		System.out.println("String i = " + i);
		System.out.println("String j = " + j);
		
		g = i == j;
		System.out.println(g);
		g = i.equals(j);
		System.out.println(g);
		
		// == 문자열 주소 비교, equals = 값을 비교
		j = "abc";
		j += "def"; // j += "a" === j = j + "a"
		StringBuffer k = new StringBuffer();
		k.append("abc");
		k.append("def");
		k.insert(0, "0");
		System.out.println("StringBuffer k = " + k);
		
		j = k.toString();
		System.out.println("j = " + j);
		
		//배열 [] []][] [][][]
		int[] l = {0,1,2,3,4,5};
		int[] m = new int[6];
		System.out.println("int[] l = " + l.toString());
		System.out.println("int[] m = " + m);
	}

}
